    "articles": [
      {
        "article_number": "第29条",
        "article_num": 29,
        "text": "愈足温者，更作芍药甘草汤与之，其脚即伸；若胃气不和，语者，少与调胃承气汤；若重发汗，复加烧针者，四逆汤主之。",
        "source": "小红书针道轩",
        "note_id": "665dc12d0000000014019c9e",
        "annotations": {
          "刘渡舟": "资料暂缺",
          "胡希恕": "资料暂缺"
        }
      },
      {
        "article_number": "第317条",
        "article_num": 317,
        "text": "少阴病，下利清谷，里寒外热，手足厥逆，脉微欲绝，身反不恶寒，其人面色赤。或腹痛，或干呕，或咽痛，或利止脉不出者，通脉四逆汤主之。(317)",
        "source": "小红书针道轩",
        "note_id": "67f52361000000001b03c1bf",
        "annotations": {
          "刘渡舟": "资料暂缺",
          "胡希恕": "资料暂缺"
        }
      },
      {
        "article_number": "第351条",
        "article_num": 351,
        "text": "手足厥寒，脉细欲绝者，当归四逆汤主之。(351)",
        "source": "小红书针道轩",
        "note_id": "683c715200000000220040de",
        "annotations": {
          "刘渡舟": "资料暂缺",
          "胡希恕": "资料暂缺"
        }
      },
      {
        "article_number": "第353条",
        "article_num": 353,
        "text": "大汗出，热不去，内拘急，四肢疼，又下利厥逆而恶寒者，四逆汤主之。(353)",
        "source": "小红书针道轩",
        "note_id": "684063e4000000002100b605",
        "annotations": {
          "刘渡舟": "资料暂缺",
          "胡希恕": "资料暂缺"
        }
      },
      {
        "article_number": "第354条",
        "article_num": 354,
        "text": "大汗，若大下利，而厥冷者，四逆汤主之。（354)",
