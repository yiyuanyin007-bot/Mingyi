<style>
:root {
  --bg-body: #fafafa;
  --bg-panel: #ffffff;
  --bg-card: #f5f5f5;
  --bg-hover: #eeeeee;
  --border: #e0e0e0;
  --text-primary: #212121;
  --text-secondary: #616161;
  --text-muted: #9e9e9e;
  --accent: #455a64;
  --accent-bg: #eceff1;
  --success: #546e7a;
  --error: #78909c;
  --shadow: 0 1px 2px rgba(0,0,0,0.06);
}

[data-theme="dark"] {
  --bg-body: #121212;
  --bg-panel: #1e1e1e;
  --bg-card: #252525;
  --bg-hover: #2d2d2d;
  --border: #333333;
  --text-primary: #e0e0e0;
  --text-secondary: #b0b0b0;
  --text-muted: #757575;
  --accent: #90a4ae;
  --accent-bg: #263238;
  --success: #90a4ae;
  --error: #b0bec5;
  --shadow: 0 1px 2px rgba(0,0,0,0.2);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  background: var(--bg-body);
  color: var(--text-primary);
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部栏 */
.topbar {
  height: 52px;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  box-shadow: var(--shadow);
  flex-shrink: 0;
}
.topbar-title { font-size: 16px; font-weight: 600; color: var(--text-primary); }
.topbar-actions { display: flex; gap: 10px; align-items: center; }
.topbar-btn {
  padding: 6px 14px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg-panel);
  color: var(--text-secondary);
  cursor: pointer;
  font-size: 13px;
  transition: all 0.15s;
}
.topbar-btn:hover { background: var(--bg-hover); color: var(--text-primary); }
.theme-btn {
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--bg-panel);
  cursor: pointer;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 主内容区 */
.main {
  flex: 1;
  overflow: hidden;
  position: relative;
}
.view {
  display: none;
  height: 100%;
  overflow-y: auto;
  padding: 24px;
  animation: fadeIn 0.2s ease;
}
.view.active { display: block; }
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* 仪表盘 */
.dashboard-header {
  max-width: 720px;
  margin: 0 auto 24px;
}
.dashboard-title { font-size: 20px; font-weight: 600; margin-bottom: 6px; }
.dashboard-desc { font-size: 13px; color: var(--text-secondary); }
.card-list {
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.card-list-item {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 18px;
  cursor: pointer;
  transition: all 0.15s;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-list-item:hover {
  border-color: var(--accent);
  background: var(--accent-bg);
}
.card-list-main { flex: 1; }
.card-list-name { font-size: 16px; font-weight: 600; }
.card-list-desc { font-size: 12px; color: var(--text-secondary); margin-top: 3px; }
.card-list-tags { display: flex; gap: 6px; margin-top: 8px; }
.tag {
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 11px;
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1px solid var(--border);
}
.progress-dots { display: flex; gap: 4px; }
.progress-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--border);
}
.progress-dot.done { background: var(--accent); }

/* 学习视图 - 单栏 */
.learn-container {
  max-width: 680px;
  margin: 0 auto;
}
.back-link {
  font-size: 13px;
  color: var(--text-secondary);
  cursor: pointer;
  margin-bottom: 16px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.back-link:hover { color: var(--accent); }
.learn-header { margin-bottom: 24px; }
.learn-name { font-size: 26px; font-weight: 700; }
.learn-tags { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }

.section {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 18px;
  margin-bottom: 14px;
}
.section-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
}
.section-body {
  font-size: 14px;
  line-height: 1.8;
  color: var(--text-primary);
}

.source-text {
  font-size: 16px;
  line-height: 1.9;
  color: var(--text-primary);
  padding: 16px;
  background: var(--bg-card);
  border-radius: 8px;
  border-left: 3px solid var(--accent);
}

.symptom-group { margin-bottom: 12px; }
.symptom-group:last-child { margin-bottom: 0; }
.symptom-label {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 6px;
}
.symptom-items { display: flex; flex-wrap: wrap; gap: 6px; }
.symptom-item {
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 13px;
  background: var(--bg-card);
  border: 1px solid var(--border);
}
.symptom-item.necessary {
  background: var(--accent-bg);
  border-color: var(--accent);
  color: var(--text-primary);
}
.symptom-item.excluding {
  text-decoration: line-through;
  opacity: 0.6;
}

.herbs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
  gap: 10px;
}
.herb-item {
  text-align: center;
  padding: 12px 8px;
  background: var(--bg-card);
  border-radius: 8px;
  border: 1px solid var(--border);
}
.herb-name { font-size: 15px; font-weight: 600; }
.herb-dose { font-size: 12px; color: var(--text-secondary); margin-top: 3px; }

.experience-box {
  background: var(--accent-bg);
  border: 1px solid var(--accent);
  border-radius: 8px;
  padding: 14px;
  margin-top: 8px;
}
.experience-title { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.experience-content { font-size: 13px; line-height: 1.7; color: var(--text-secondary); }
.efficacy-tags { display: flex; gap: 6px; margin-top: 10px; }

.action-bar {
  display: flex;
  gap: 10px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}
.btn-primary {
  padding: 10px 20px;
  border-radius: 8px;
  border: none;
  background: var(--accent);
  color: white;
  font-size: 14px;
  cursor: pointer;
  transition: opacity 0.15s;
}
.btn-primary:hover { opacity: 0.85; }
.btn-secondary {
  padding: 10px 20px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--bg-panel);
  color: var(--text-secondary);
  font-size: 14px;
  cursor: pointer;
}
.btn-secondary:hover { background: var(--bg-hover); }

/* 考试视图 - 双栏 */
.exam-layout {
  max-width: 900px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  height: 100%;
}
.exam-question {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 24px;
}
.exam-question-title {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 12px;
}
.exam-question-body {
  font-size: 18px;
  line-height: 1.7;
  font-weight: 500;
}
.exam-question-hint {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 16px;
}
.exam-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.exam-option {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px;
  cursor: pointer;
  font-size: 15px;
  transition: all 0.15s;
  text-align: left;
}
.exam-option:hover {
  border-color: var(--accent);
  background: var(--accent-bg);
}
.exam-option.selected {
  border-color: var(--accent);
  background: var(--accent-bg);
}
.exam-option.correct {
  border-color: var(--success);
  background: rgba(84,110,122,0.12);
}
.exam-option.wrong {
  border-color: var(--error);
  background: rgba(120,144,156,0.12);
}
.exam-feedback {
  margin-top: 16px;
  padding: 14px;
  border-radius: 8px;
  font-size: 13px;
  line-height: 1.6;
  display: none;
}
.exam-feedback.show { display: block; }

.exam-progress {
  max-width: 900px;
  margin: 0 auto 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--text-secondary);
}
.exam-nav {
  max-width: 900px;
  margin: 20px auto 0;
  display: flex;
  justify-content: flex-end;
}

/* 统计视图 */
.stats-grid {
  max-width: 720px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 14px;
}
.stat-card {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 18px;
}
.stat-value { font-size: 28px; font-weight: 700; color: var(--accent); }
.stat-label { font-size: 12px; color: var(--text-secondary); margin-top: 4px; }

::-webkit-scrollbar { width: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

.version-badge {
  font-size: 11px;
  font-weight: 500;
  padding: 2px 8px;
  border-radius: 10px;
  background: var(--accent-bg);
  color: var(--accent);
  border: 1px solid var(--accent);
  margin-left: 8px;
  vertical-align: middle;
}

/* 桌面版宽屏布局 */
.dashboard-header,
.card-list,
.learn-container,
.exam-layout,
.exam-progress,
.exam-nav,
.stats-grid {
  max-width: 1400px;
}

.card-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 14px;
}

.learn-container {
  width: 100%;
}

.learn-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: start;
}

.learn-col {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.learn-col .section {
  margin-bottom: 0;
}

.action-bar {
  margin-top: 20px;
}

.exam-layout {
  max-width: 1200px;
  gap: 32px;
}

.exam-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.exam-option {
  min-height: 80px;
  display: flex;
  align-items: center;
}

/* 键盘焦点高亮 */
button:focus-visible,
.card-list-item:focus-visible,
.exam-option:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Kimi 导师弹窗 */
.tutor-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.tutor-modal {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  width: min(600px, 90vw);
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow);
}
.tutor-title {
  font-size: 15px;
  font-weight: 600;
  margin-bottom: 12px;
}
.tutor-text {
  width: 100%;
  height: 280px;
  resize: none;
  font-family: inherit;
  font-size: 13px;
  line-height: 1.7;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg-body);
  color: var(--text-primary);
}
.tutor-actions {
  margin-top: 14px;
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}
</style>
</head>
