// 生成考试题
function generateQuestions(cardId) {
  const card = getCard(cardId);
  if (!card) return [];
  const c = card.data.canonical;
  const profile = c.symptom_profile || {};
  const allSymptoms = [...(profile.necessary || []), ...(profile.common || [])];
  const questions = [];

  // 0→1: 方名→症状
  const necessaryJoined = (profile.necessary || []).join('、');
  questions.push({
    type: '0→1',
    text: `${card.name}的必要症状包括哪些？`,
    correct: necessaryJoined,
    options: generateOptions(cardId, '0→1', necessaryJoined)
  });

  // 1→0: 症状→方名
  if (allSymptoms.length > 0) {
    questions.push({
      type: '1→0',
      text: `患者出现 ${allSymptoms.slice(0, 2).join('、')}，最可能选哪个方？`,
      correct: card.id,
      options: generateOptions(cardId, '1→0')
    });
  }

  // 0→2: 方名→药物
  if (c.herbs.length > 0) {
    questions.push({
      type: '0→2',
      text: `${card.name}包含以下哪味药？`,
      correct: [c.herbs[0].name],
      options: generateOptions(cardId, '0→2', c.herbs[0].name)
    });
  }

  // 0→contra: 方名→禁忌
  if (c.contraindications.length > 0) {
    questions.push({
      type: '0→contra',
      text: `${card.name}的禁忌是什么？`,
      correct: [c.contraindications[0]],
      options: generateOptions(cardId, '0→contra', c.contraindications[0])
    });
  }

  return questions;
}

function generateOptions(cardId, type, correctValue) {
  const target = getCard(cardId);
  const targetCanonical = target.data.canonical;
  const targetProfile = targetCanonical.symptom_profile || {};

  // 计算正确答案的标签
  let correctLabel;
  if (type === '0→1') {
    correctLabel = (targetProfile.necessary || []).join('、') || '无';
  } else if (type === '1→0' || type === '2→0') {
    correctLabel = target.name;
  } else if (type === '0→2') {
    correctLabel = (targetCanonical.herbs[0] && targetCanonical.herbs[0].name) || '无';
  } else if (type === '0→contra') {
    correctLabel = targetCanonical.contraindications[0] || '无';
  } else if (type === '0→usage') {
    correctLabel = targetCanonical.usage || '无';
  }

  // 构建正确答案选项
  const opts = [{ id: target.id, label: correctLabel }];
  const usedLabels = new Set([correctLabel]);

  // 从其他卡片中抽取标签不重复的干扰项
  const others = CARDS.filter(c => c.id !== cardId);
  const shuffled = others.sort(() => Math.random() - 0.5);

  for (const c of shuffled) {
    if (opts.length >= 4) break;
    const canonical = c.data.canonical;
    const profile = canonical.symptom_profile || {};
    let label;
    if (type === '0→1') {
      label = (profile.necessary || []).join('、') || '无';
    } else if (type === '1→0' || type === '2→0') {
      label = c.name;
    } else if (type === '0→2') {
      const herbs = canonical.herbs.map(h => h.name);
      label = herbs[0] || '无';
    } else if (type === '0→contra') {
      label = canonical.contraindications[0] || '无';
    } else if (type === '0→usage') {
      label = canonical.usage || '无';
    }
    if (!usedLabels.has(label)) {
      usedLabels.add(label);
      opts.push({ id: c.id, label });
    }
  }

  // 极端情况下（题库太小）仍凑不够 4 个，用占位补齐
  while (opts.length < 4) {
    const fallback = `选项 ${opts.length + 1}`;
    if (!usedLabels.has(fallback)) {
      usedLabels.add(fallback);
      opts.push({ id: `fallback-${opts.length}`, label: fallback });
    }
  }

  return opts.sort(() => Math.random() - 0.5);
}

function startExam(cardId) {
  state.activeCardId = cardId;
  state.exam.questions = generateQuestions(cardId);
  state.exam.current = 0;
  state.exam.answers = [];
  state.exam.finished = false;
  state.exam.mode = 'card';
  switchView('exam');
  renderExam();
}

function renderExam() {
  const q = state.exam.questions[state.exam.current];
  if (!q) return;

  document.getElementById('examProgress').textContent =
    `题目 ${state.exam.current + 1} / ${state.exam.questions.length}`;
  document.getElementById('examQuestion').textContent = q.text;
  document.getElementById('examHint').textContent = `类型：${q.type}`;

  const optsContainer = document.getElementById('examOptions');
  optsContainer.innerHTML = q.options.map((opt, idx) => `
    <button class="exam-option" id="opt-${idx}" onclick="selectOption(${idx})">
      ${opt.label}
    </button>
  `).join('');

  document.getElementById('examFeedback').className = 'exam-feedback';
  document.getElementById('examFeedback').innerHTML = '';
  document.getElementById('examNav').innerHTML = '';
}

function selectOption(idx) {
  if (state.exam.finished) return;
  const q = state.exam.questions[state.exam.current];
  const selected = q.options[idx];
  const isCorrect = q.type === '1→0'
    ? selected.id === q.correct
    : (Array.isArray(q.correct) ? q.correct.includes(selected.label) : selected.label === q.correct);

  state.exam.answers.push({ question: q, selected, isCorrect });
  state.exam.finished = true;
  state.stats.total++;
  if (isCorrect) state.stats.right++; else state.stats.wrong++;

  // 更新掌握度并持久化
  updateMasteryAfterAnswer(q.type, isCorrect);

  // UI 反馈
  q.options.forEach((opt, i) => {
    const btn = document.getElementById(`opt-${i}`);
    const optCorrect = q.type === '1→0'
      ? opt.id === q.correct
      : (Array.isArray(q.correct) ? q.correct.includes(opt.label) : opt.label === q.correct);
    if (optCorrect) btn.classList.add('correct');
    if (i === idx && !optCorrect) btn.classList.add('wrong');
    btn.disabled = true;
  });

  const fb = document.getElementById('examFeedback');
  fb.className = 'exam-feedback show';
  fb.innerHTML = isCorrect
    ? `<strong>回答正确。</strong> ${q.type === '1→0' ? '该症状组合指向' + slugToName(q.correct) : ''}`
    : `<strong>回答错误。</strong> 正确答案是：${Array.isArray(q.correct) ? q.correct.join('、') : q.correct}`;

  const nav = document.getElementById('examNav');
  if (state.exam.current < state.exam.questions.length - 1) {
    nav.innerHTML = `<button class="btn-primary" onclick="nextQuestion()">下一题</button>`;
  } else {
    nav.innerHTML = `<button class="btn-primary" onclick="finishExam()">完成</button>`;
  }
}

function nextQuestion() {
  state.exam.current++;
  state.exam.finished = false;
  renderExam();
}

function finishExam() {
  goToLearn(state.activeCardId);
}

function renderStats() {
  const totalCards = CARDS.length;
  const mastered = CARDS.reduce((sum, c) => {
    return sum + Object.values(c.mastery || {}).filter(m => m.status === '已掌握').length;
  }, 0);
  const totalVectors = CARDS.reduce((sum, c) => sum + Object.keys(c.mastery || {}).length, 0);

  document.getElementById('statsGrid').innerHTML = `
    <div class="stat-card"><div class="stat-value">${totalCards}</div><div class="stat-label">方剂卡</div></div>
    <div class="stat-card"><div class="stat-value">${state.stats.total}</div><div class="stat-label">本次会话答题数</div></div>
    <div class="stat-card"><div class="stat-value">${state.stats.right}</div><div class="stat-label">正确</div></div>
    <div class="stat-card"><div class="stat-value">${state.stats.wrong}</div><div class="stat-label">错误</div></div>
    <div class="stat-card"><div class="stat-value">${mastered}/${totalVectors}</div><div class="stat-label">已掌握向量</div></div>
  `;
}


// 桌面版键盘快捷键
document.addEventListener('keydown', (e) => {
  // 忽略输入框中的按键
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

  // 仪表盘：方向键/Enter 选择卡片
  if (state.page === 'dashboard') {
    const items = document.querySelectorAll('.card-list-item');
    const current = document.activeElement;
    let idx = Array.from(items).indexOf(current);
    if (e.key === 'ArrowDown' || e.key === 'j' || e.key === 'J') {
      e.preventDefault();
      idx = Math.min(idx + 1, items.length - 1);
      if (idx >= 0) items[idx].focus();
      else if (items.length > 0) items[0].focus();
    } else if (e.key === 'ArrowUp' || e.key === 'k' || e.key === 'K') {
      e.preventDefault();
      idx = Math.max(idx - 1, 0);
      if (idx >= 0) items[idx].focus();
    } else if (e.key === 'Enter' && current.classList.contains('card-list-item')) {
      e.preventDefault();
      current.click();
    }
    return;
  }

  // 学习视图
  if (state.page === 'learn') {
    if (e.key === 'Enter') {
      e.preventDefault();
      startExam(state.activeCardId);
    } else if (e.key === 'Escape' || e.key === 'Backspace') {
      e.preventDefault();
      goToDashboard();
    }
    return;
  }

  // 考试视图
  if (state.page === 'exam') {
    if (state.exam.finished) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const nextBtn = document.querySelector('.exam-nav button');
        if (nextBtn) nextBtn.click();
      }
      return;
    }
    if (e.key >= '1' && e.key <= '4') {
      const idx = parseInt(e.key, 10) - 1;
      const opts = document.querySelectorAll('.exam-option');
      if (opts[idx]) {
        e.preventDefault();
        selectOption(idx);
      }
    } else if (e.key === 'Escape') {
      e.preventDefault();
      goToLearn(state.activeCardId);
    }
    return;
  }

  // 统计视图
  if (state.page === 'stats') {
    if (e.key === 'Escape') {
      e.preventDefault();
      goToDashboard();
    }
  }
});

// 让卡片列表项可聚焦
document.addEventListener('renderDashboardComplete', () => {
  document.querySelectorAll('.card-list-item').forEach(el => el.setAttribute('tabindex', '0'));
});

// 初始化：加载数据后渲染仪表盘
loadData().then(() => {
  CARDS.forEach(ensureMasteryFields);
  loadProgress();
  renderDashboard();
  renderReviewPanel();
});
</script>

